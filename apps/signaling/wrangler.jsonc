{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "from-computer-to-phone-signaling",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITER", "class_name": "Limiter" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Limiter"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "SESSION_TTL_SECONDS": "86400",
    "HOST_GRACE_SECONDS": "15",
    "STUN_URLS": "stun:stun.cloudflare.com:3478",
  },
  "observability": { "enabled": false },
}
